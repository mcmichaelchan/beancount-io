{
    auto_https off
    admin off
}

:8080 {
    encode gzip

    @api path /api-gateway /api-gateway/* /.well-known/* /git/* /healthz
    handle @api {
        reverse_proxy backend-v2:4104 {
            header_up Host {$PUBLIC_HOST}
            header_up X-Forwarded-Host {$PUBLIC_HOST}
            header_up X-Forwarded-Proto https
        }
    }

    handle {
        reverse_proxy dashboard:3000 {
            header_up Host {$PUBLIC_HOST}
            header_up X-Forwarded-Host {$PUBLIC_HOST}
            header_up X-Forwarded-Proto https
        }
    }
}
